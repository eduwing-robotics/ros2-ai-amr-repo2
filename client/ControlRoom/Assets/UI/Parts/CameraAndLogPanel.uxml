<!-- CameraAndLogPanel.uxml — 중앙 하단 드로어: 카메라/로그 탭 전환. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../ControlRoomTokens.uss" />
    <Style src="../ControlRoomStyle.uss" />
    <Style src="../ControlRoomLayout.uss" />
    <Style src="../ControlRoomMap.uss" />
    <Style src="../ControlRoomPanels.uss" />
    <ui:VisualElement name="camera-log-row" class="camera-log-row card">
        <ui:VisualElement class="bottom-tabs">
            <ui:Button name="bottom-tab-camera" text="카메라" class="panel-tab active" />
            <ui:Button name="bottom-tab-log" text="로그" class="panel-tab" />
        </ui:VisualElement>
        <ui:VisualElement name="bottom-panel-camera" class="bottom-page">
            <ui:VisualElement name="camera-panel" class="camera-panel">
                <ui:VisualElement class="camera-header">
                    <ui:Label text="카메라 (선택 로봇)" class="camera-label" />
                    <ui:VisualElement class="camera-live-dot" />
                </ui:VisualElement>
                <ui:Image name="camera-image" class="camera-image-placeholder">
                    <ui:VisualElement class="camera-crosshair-v" />
                    <ui:VisualElement class="camera-crosshair-h" />
                    <ui:Label name="camera-placeholder-text" text="RGB feed — ROS 연결 대기" class="camera-placeholder-text" />
                </ui:Image>
                <ui:Label name="camera-hz" text="-- Hz" class="camera-hz" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom-panel-log" class="bottom-page hidden">
            <ui:ScrollView name="log-panel" class="log-panel">
                <ui:Label text="이벤트 로그" class="card-title" />
                <ui:VisualElement name="log-list">
                    <ui:Label text="[00:00:01] 시스템 부팅 완료" class="log-entry" />
                    <ui:Label text="[00:00:02] 시나리오 로드: 박물관 정상 운영" class="log-entry" />
                    <ui:Label text="[00:00:03] 센서 4종 활성 (PIR/소음/온도/레이저)" class="log-entry" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
