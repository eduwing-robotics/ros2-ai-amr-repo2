<!-- LeftControlPanel.uxml — 좌측 제어 패널: 운영/상황/순찰 탭으로 기능 노출량을 조절. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../ControlRoomTokens.uss" />
    <Style src="../ControlRoomStyle.uss" />
    <Style src="../ControlRoomLayout.uss" />
    <Style src="../ControlRoomMap.uss" />
    <Style src="../ControlRoomPanels.uss" />
    <ui:VisualElement name="left-panel" class="left-panel">
        <ui:VisualElement class="panel-tabs">
            <ui:Button name="left-tab-ops" text="운영" class="panel-tab active" />
            <ui:Button name="left-tab-scenario" text="상황" class="panel-tab" />
            <ui:Button name="left-tab-patrol" text="순찰" class="panel-tab" />
        </ui:VisualElement>
        <ui:ScrollView name="left-panel-scroll" class="left-panel-scroll">
        <ui:VisualElement name="left-panel-ops" class="panel-page">
            <ui:VisualElement class="card">
                <ui:Label text="운영" class="card-title" />
                <ui:VisualElement class="btn-row">
                    <ui:Button name="btn-mode-auto" text="자동" class="btn-mode active" />
                    <ui:Button name="btn-mode-manual" text="수동" class="btn-mode" />
                </ui:VisualElement>
                <ui:VisualElement class="btn-row">
                    <ui:Button name="btn-patrol-start" text="순회 시작" class="btn-action" />
                    <ui:Button name="btn-patrol-stop" text="순회 정지" class="btn-action" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="robot-role-card" class="card role-card">
                <ui:VisualElement class="role-header">
                    <ui:VisualElement name="robot-role-icon" class="role-icon" />
                    <ui:VisualElement class="role-meta">
                        <ui:Label name="robot-role-name" text="--" class="role-name" />
                        <ui:Label name="robot-role-status" text="연결 대기" class="role-status" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="robot-role-badge" text="역할" class="role-badge" />
            </ui:VisualElement>
            <ui:VisualElement class="card">
                <ui:Label text="퀵 액션" class="card-title" />
                <ui:VisualElement class="quick-actions-grid">
                    <ui:Button name="btn-quick-stop" text="즉시정지" class="quick-action-btn danger" />
                    <ui:Button name="btn-quick-home" text="충전소복귀" class="quick-action-btn" />
                    <ui:Button name="btn-quick-park" text="ArUco주차" class="quick-action-btn" />
                    <ui:Button name="btn-quick-lock" text="주행잠금" class="quick-action-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="teleop-card" class="card teleop-card">
                <ui:Label text="수동 조종" class="card-title" />
                <ui:VisualElement class="teleop-grid">
                    <ui:VisualElement class="teleop-spacer" />
                    <ui:Button name="btn-teleop-forward" text="▲" class="teleop-btn" />
                    <ui:VisualElement class="teleop-spacer" />
                    <ui:Button name="btn-teleop-left" text="◀" class="teleop-btn" />
                    <ui:Button name="btn-teleop-stop" text="●" class="teleop-btn stop" />
                    <ui:Button name="btn-teleop-right" text="▶" class="teleop-btn" />
                    <ui:VisualElement class="teleop-spacer" />
                    <ui:Button name="btn-teleop-back" text="▼" class="teleop-btn" />
                    <ui:VisualElement class="teleop-spacer" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="card card-fill">
                <ui:Label text="특수 모드" class="card-title" />
                <ui:VisualElement class="toggle-row">
                    <ui:Toggle name="toggle-scan" label="360°" class="feature-toggle" />
                    <ui:Toggle name="toggle-turbo" label="가속" class="feature-toggle" />
                    <ui:Toggle name="toggle-slam" label="SLAM" class="feature-toggle" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="left-panel-scenario" class="panel-page hidden">
            <ui:VisualElement class="card card-fill">
                <ui:Label text="위험상황 테스트" class="card-title" />
                <ui:VisualElement name="scenario-button-list" class="scenario-button-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="left-panel-patrol" class="panel-page hidden">
            <ui:VisualElement class="card card-fill">
                <ui:Label text="순회 지점" class="card-title" />
                <ui:VisualElement name="waypoint-list" class="waypoint-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
