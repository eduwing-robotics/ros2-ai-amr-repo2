/* ControlRoomStyle.uss — 공통 UI 원자 스타일.
   화면 배치는 ControlRoomLayout.uss, 도메인 패널은 ControlRoomPanels.uss가 담당. */

.root {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
}

.hidden { display: none; }
.spacer { flex-grow: 1; }

/* TopBar */
.top-bar {
    height: var(--topbar-height);
    flex-direction: row;
    background-color: var(--color-surface);
    border-bottom-width: var(--border-width);
    border-bottom-color: var(--color-border);
    padding-left: var(--space-md);
    padding-right: var(--space-md);
    align-items: center;
}

.logo {
    -unity-font-style: bold;
    font-size: var(--font-size-lg);
    margin-right: var(--space-lg);
}

.robot-tabs {
    flex-direction: row;
}

.robot-tab {
    margin-right: var(--space-xs);
    background-color: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text-secondary);
    padding-left: var(--space-md);
    padding-right: var(--space-md);
}

.robot-tab.active {
    background-color: var(--color-accent);
    color: var(--color-surface);
}

.clock {
    margin-right: var(--space-md);
    color: var(--color-text-secondary);
}

.alert-count {
    margin-right: var(--space-md);
    color: var(--color-status-danger);
    -unity-font-style: bold;
}

.btn-power {
    background-color: var(--color-status-danger);
    color: white;
    border-radius: var(--radius-sm);
}

/* Cards and buttons */
.card {
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    border-width: var(--border-width);
    border-color: var(--color-border);
    padding: var(--space-sm);
    margin-bottom: var(--space-xs);
    flex-shrink: 0;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
}

.card-fill {
    flex-grow: 1;
}

.card-title {
    -unity-font-style: bold;
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
}

.muted {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

.btn-scenario, .btn-mode, .btn-action, .btn-map-mode, .panel-tab {
    margin-bottom: var(--space-xxs);
    background-color: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text-primary);
    padding-top: var(--space-xxs);
    padding-bottom: var(--space-xxs);
}

.btn-scenario:hover, .btn-mode:hover, .btn-action:hover, .btn-map-mode:hover, .panel-tab:hover {
    background-color: var(--color-bg-primary);
}

.btn-mode.active, .btn-map-mode.active, .btn-action.active, .panel-tab.active {
    background-color: var(--color-accent);
    color: var(--color-surface);
    border-color: var(--color-accent);
}

.btn-action.active {
    background-color: var(--color-status-ok);
    border-color: var(--color-status-ok);
}

.btn-row {
    flex-direction: row;
    margin-bottom: var(--space-xxs);
}

.btn-row > .btn-mode,
.btn-row > .btn-action {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 1px;
    margin-right: 1px;
    margin-bottom: 0;
}

.toggle-row {
    flex-direction: row;
    justify-content: space-between;
}

.toggle-row > .feature-toggle {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: var(--space-xxs);
    margin-right: var(--space-xxs);
}

/* Alert popup */
.alert-popup {
    position: absolute;
    top: 64px;
    left: 30%;
    width: 40%;
    background-color: var(--color-status-danger);
    color: var(--color-text-inverse);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    display: none;
    align-items: center;
}

.alert-popup.visible { display: flex; }

.alert-popup-message {
    color: var(--color-text-inverse);
    -unity-font-style: bold;
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-sm);
}
