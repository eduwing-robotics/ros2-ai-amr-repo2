[Unit]
Description=URHYNIX urhynix-bridge
[Service]
Type=simple
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source /home/t1/turtlebot3_ws/install/setup.bash 2>/dev/null; export ROS_DOMAIN_ID=2 RMW_IMPLEMENTATION=rmw_fastrtps_cpp ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET; exec python3 /home/t1/patrol_waypoints_bridge.py --robot tb3_1"
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
