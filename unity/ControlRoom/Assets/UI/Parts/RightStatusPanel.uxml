<!-- RightStatusPanel.uxml — 우측 상태 패널: 상태/센서/기능/보호대상 탭. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../ControlRoomTokens.uss" />
    <Style src="../ControlRoomStyle.uss" />
    <Style src="../ControlRoomLayout.uss" />
    <Style src="../ControlRoomMap.uss" />
    <Style src="../ControlRoomPanels.uss" />
    <ui:VisualElement name="right-panel" class="right-panel">
        <ui:VisualElement class="panel-tabs">
            <ui:Button name="right-tab-status" text="상태" class="panel-tab active" />
            <ui:Button name="right-tab-sensors" text="센서" class="panel-tab" />
            <ui:Button name="right-tab-inventory" text="기능" class="panel-tab" />
            <ui:Button name="right-tab-targets" text="보호" class="panel-tab" />
        </ui:VisualElement>
        <ui:VisualElement name="right-panel-status" class="panel-page">
            <ui:VisualElement class="card">
                <ui:Label text="배터리" class="card-title" />
                <ui:Label name="battery-percent-label" text="-- %" class="battery-percent" />
                <ui:VisualElement class="battery-bar-bg">
                    <ui:VisualElement name="battery-bar-fill" class="battery-bar-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="card card-fill">
                <ui:Label text="하드웨어" class="card-title" />
                <ui:Label name="hardware-info-label" text="(로봇 선택 시 표시)" class="muted" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right-panel-sensors" class="panel-page hidden">
            <ui:VisualElement class="card card-fill">
                <ui:Label text="센서" class="card-title" />
                <ui:VisualElement name="sensor-card-list" class="sensor-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right-panel-inventory" class="panel-page hidden">
            <ui:VisualElement class="card card-fill">
                <ui:Label text="기능 상태" class="card-title" />
                <ui:VisualElement name="feature-inventory-list" class="inventory-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right-panel-targets" class="panel-page hidden">
            <ui:VisualElement class="card card-fill">
                <ui:Label text="보호대상" class="card-title" />
                <ui:VisualElement name="protected-target-list" class="protected-target-list" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
