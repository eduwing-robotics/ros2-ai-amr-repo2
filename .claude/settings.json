{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.prompt // empty' | grep -qiE \"핸드오프|handoff\" && cat \"${CLAUDE_PROJECT_DIR:-/Users/family/jason/URHYNIX}/docs/status/HANDOFF.md\" 2>/dev/null || true",
            "statusMessage": "핸드오프 캡슐 로딩"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/doc-drift-reminder.sh"
          }
        ]
      }
    ]
  }
}
