[Unit]
Description=URHYNIX urhynix-readyd (티원 주행준비 원버튼 온디맨드 트리거)
[Service]
Type=simple
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source /home/t1/turtlebot3_ws/install/setup.bash 2>/dev/null; export ROS_DOMAIN_ID=2 RMW_IMPLEMENTATION=rmw_fastrtps_cpp ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET; exec python3 /home/t1/readyd.py"
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
